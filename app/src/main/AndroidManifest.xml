<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- vehicle speed (to tell IDLING from MOVING); asked at runtime -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ask a neighbour by voice -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <queries>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
    </queries>
    <!-- navigation destination / remaining time (read-only) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />

    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gildongmu">

        <!-- AAOS car API; absent on a phone, so not required -->
        <uses-library
            android:name="android.car"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustResize">

            <!-- Distraction Optimization: allowed while the car is idling/moving.
                 Verified on the Pleos emulator: without this the platform shows
                 "주행 중에는 사용할 수 없습니다." (see probe_app). -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />

            <!-- gildongmu://server?url=http://<pc>:8080 : tells a phone where the server is -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="gildongmu" android:host="server" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
